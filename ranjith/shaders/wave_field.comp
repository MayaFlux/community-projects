#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

/// Slot transform buffer: mat4 per slot, column-major, read and written in place.
layout(set = 0, binding = 0) buffer TransformBuffer {
    float data[];
} transforms;

layout(push_constant) uniform PC {
    uint slot_count;
    uint grid_w;
    float time;
    float amplitude;
    float frequency;
    float speed;
} pc;

/// Read a mat4 from the flat float buffer at slot index i.
mat4 read_transform(uint i)
{
    uint base = i * 16u;
    return mat4(
        transforms.data[base + 0], transforms.data[base + 1],
        transforms.data[base + 2], transforms.data[base + 3],
        transforms.data[base + 4], transforms.data[base + 5],
        transforms.data[base + 6], transforms.data[base + 7],
        transforms.data[base + 8], transforms.data[base + 9],
        transforms.data[base + 10], transforms.data[base + 11],
        transforms.data[base + 12], transforms.data[base + 13],
        transforms.data[base + 14], transforms.data[base + 15]
    );
}

/// Write a mat4 back into the flat float buffer at slot index i.
void write_transform(uint i, mat4 m)
{
    uint base = i * 16u;
    transforms.data[base + 0] = m[0][0];
    transforms.data[base + 1] = m[0][1];
    transforms.data[base + 2] = m[0][2];
    transforms.data[base + 3] = m[0][3];
    transforms.data[base + 4] = m[1][0];
    transforms.data[base + 5] = m[1][1];
    transforms.data[base + 6] = m[1][2];
    transforms.data[base + 7] = m[1][3];
    transforms.data[base + 8] = m[2][0];
    transforms.data[base + 9] = m[2][1];
    transforms.data[base + 10] = m[2][2];
    transforms.data[base + 11] = m[2][3];
    transforms.data[base + 12] = m[3][0];
    transforms.data[base + 13] = m[3][1];
    transforms.data[base + 14] = m[3][2];
    transforms.data[base + 15] = m[3][3];
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.slot_count)
        return;

    mat4 t = read_transform(i);

    // Grid column and row from flat index.
    uint col = i % pc.grid_w;
    uint row = i / pc.grid_w;

    // Rest position is the translation component of the initial transform.
    // The initial upload encodes the grid layout in column 3.
    float rest_x = t[3][0];
    float rest_y = t[3][1];

    // Diagonal wave: phase offset proportional to grid position so the
    // wavefront travels from one corner to the opposite corner.
    float phase = pc.frequency * (rest_x + rest_y) - pc.speed * pc.time;
    float dz = pc.amplitude * sin(phase);

    t[3][2] = dz;

    write_transform(i, t);
}
